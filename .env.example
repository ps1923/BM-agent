# Copy to .env and fill secrets locally. Never commit .env.
DB_URL=jdbc:mysql://host.docker.internal:3306/BM-sql?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USER=bm_app
DB_PASSWORD=

# deterministic works without a model key and is intended for integration tests/demo fallback.
HARNESS_PROVIDER=deterministic
# Use 0.0.0.0 only inside the isolated Compose network. Local module runs default to 127.0.0.1.
HARNESS_HOST=127.0.0.1
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
REQUIREMENTS_MODEL=
PLANNER_MODEL=

API_PORT=8080
ALLOWED_ORIGIN=http://127.0.0.1:8000
# Local API defaults to one demo user. Only enable this for explicit multi-user isolation tests.
ALLOW_DEMO_USER_HEADER=false
