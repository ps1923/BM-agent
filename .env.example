# Copy to .env and fill secrets locally. Never commit .env.
DB_URL=jdbc:mysql://host.docker.internal:3306/BM-sql?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USER=bm_app
DB_PASSWORD=

# deterministic works without a model key and is intended for integration tests/demo fallback.
HARNESS_PROVIDER=deterministic
# Use 0.0.0.0 only inside the isolated Compose network. Local module runs default to 127.0.0.1.
HARNESS_HOST=127.0.0.1
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
REQUIREMENTS_MODEL=
PLANNER_MODEL=

# Student code guidance. Keep the key empty in source control and provide it only at runtime.
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=PT45S
GUIDANCE_MAX_CONTEXT_CHARS=120000
DIAGNOSIS_MAX_WORKERS=2
DIAGNOSIS_MAX_QUEUE=16
DIAGNOSIS_MAX_CONTEXT_CHARS=180000
DIAGNOSIS_MAX_FILE_CHARS=30000
DIAGNOSIS_MAX_PATCHES=5

# RAG services. Use protocol=tei for the official TEI /embed endpoint, or
# protocol=openai for an OpenAI-compatible /embeddings endpoint.
EMBEDDING_BASE_URL=http://127.0.0.1:8001
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_PROTOCOL=tei
CHROMA_BASE_URL=http://127.0.0.1:8000
CHROMA_COLLECTION=bm_hs_bugs
CHROMA_API_KEY=

API_PORT=8080
ALLOWED_ORIGIN=http://127.0.0.1:8000,http://localhost:8000
# Terminal output is retained up to this many UTF-8 bytes (hard maximum: 1048576).
WORKSPACE_MAX_OUTPUT_BYTES=65536
# Local API defaults to one demo user. Only enable this for explicit multi-user isolation tests.
ALLOW_DEMO_USER_HEADER=false
